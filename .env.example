# ============================================================
# Pengaturan FRONTEND (React/Vite). Salin jadi ".env" lalu isi.
# ============================================================
# Semua variabel berawalan VITE_ IKUT TERBACA di website/APK (siapa pun bisa melihatnya),
# jadi di sini HANYA boleh ada nilai yang tidak rahasia.

# Alamat backend Asisten Belajar Kak Carta (Cloudflare Worker). Bukan rahasia.
VITE_TUTOR_URL=https://cartes-play-tutor.<akun-anda>.workers.dev

# ⚠️ JANGAN menulis API key di sini (misalnya VITE_DEEPSEEK_API_KEY).
# Kunci DeepSeek/Gemini disimpan di SERVER sebagai secret Cloudflare:
#   cd server
#   npx wrangler secret put DEEPSEEK_API_KEY
# Untuk uji coba backend di laptop, lihat server/.dev.vars.example
