          "axis": "X",
          "grid": {
            "range": 10,
            "buildings": [
              "terminal"
            ]
          }
        },
        {
          "id": "misi4-4",
          "kind": "choice",
          "phase": "independent",
          "text": [
            "Mana yang **lebih dekat** ke Jalan Utama Mendatar?"
          ],
          "options": [
            {
              "text": "Terminal, karena jaraknya 3 blok",
              "correct": true,
              "feedback": "Tepat! Terminal 3 blok, Rumah Sakit 4 blok. Jadi Terminal lebih dekat."
            },
            {
              "text": "Rumah Sakit, karena jaraknya 4 blok",
              "feedback": "Belum tepat. 4 blok lebih jauh daripada 3 blok."
            },
            {
              "text": "Terminal, karena x-nya 6",
              "feedback": "Jawabannya Terminal, tapi alasannya belum tepat. Jarak ke sumbu-X dilihat dari y, bukan x."
            }
          ]
        }
